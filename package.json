{
  "name": "cite-du-tournoi-hd2d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Procedural HD-2D runtime prototype: Merchant District of Cite du Tournoi, generated entirely from code.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "shots": "node tools/screenshots.mjs",
    "compare": "node tools/compare.mjs",
    "art:doctor": "node tools/art-lab/doctor.mjs",
    "art:validate": "node tools/art-lab/validate-manifest.mjs",
    "art:sheet": "node tools/art-lab/make-contact-sheet.mjs",
    "art:lab": "vite --open /character-lab.html"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "puppeteer-core": "25.12.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
